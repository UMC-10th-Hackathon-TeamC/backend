generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// 서울 25개 자치구 마스터 데이터
model District {
  id        Int    @id @default(autoincrement())
  name      String @unique
  latitude  Float
  longitude Float
  nx        Int
  ny        Int

  mosquitoIndices MosquitoIndex[]
  dailyWeathers   DailyWeather[]
  posts           Post[]
}

// 자치구별 일일 모기지수
model MosquitoIndex {
  id            Int      @id @default(autoincrement())
  districtId    Int
  date          DateTime @db.Date
  mosquitoIndex Float
  level         Int
  compositeTemp Float
  compositeHum  Float
  minTemp       Float
  createdAt     DateTime @default(now())

  district District @relation(fields: [districtId], references: [id], onDelete: Cascade)

  @@unique([districtId, date])
}

// 자치구별 일일 기상 데이터
model DailyWeather {
  id         Int      @id @default(autoincrement())
  districtId Int
  date       DateTime @db.Date
  avgTemp    Float
  avgHum     Float
  createdAt  DateTime @default(now())

  district District @relation(fields: [districtId], references: [id], onDelete: Cascade)

  @@unique([districtId, date])
}

// 사용자
model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  nickname     String
  profileImage String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  posts    Post[]
  comments Comment[]
  likes    Like[]
}

// 게시글
model Post {
  id         Int      @id @default(autoincrement())
  userId     Int
  districtId Int
  category   String
  title      String
  content    String   @db.Text
  viewCount  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  district District  @relation(fields: [districtId], references: [id], onDelete: Cascade)
  comments Comment[]
  likes    Like[]
}

// 댓글
model Comment {
  id        Int      @id @default(autoincrement())
  postId    Int
  userId    Int
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// 좋아요
model Like {
  id        Int      @id @default(autoincrement())
  postId    Int
  userId    Int
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}
